{
  "name": "@otea/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The asynchronous handoff surface between you and your AI agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "build:ui": "vite build ui",
    "dev:ui": "vite ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build:ui",
    "otea": "node --disable-warning=ExperimentalWarning src/cli/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
